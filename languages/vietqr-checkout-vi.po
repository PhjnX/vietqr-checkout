#. Plugin Name of the plugin
#: vietqr-checkout.php
msgid "VietQR Checkout for WooCommerce"
msgstr "VietQR Checkout cho WooCommerce"

#. Plugin URI of the plugin
#: vietqr-checkout.php
msgid "https://github.com/PhjnX/vietqr-checkout"
msgstr ""

#. Description of the plugin
#: vietqr-checkout.php
msgid "Accept Vietnamese bank transfers via VietQR. Orders are confirmed automatically when the money arrives (SePay webhook)."
msgstr "Nhận chuyển khoản ngân hàng qua VietQR. Đơn hàng được xác nhận tự động khi tiền về (webhook SePay)."

#. Author of the plugin
#: vietqr-checkout.php
msgid "Bui Hoang Phi"
msgstr ""

#. Author URI of the plugin
#: vietqr-checkout.php
msgid "https://github.com/PhjnX"
msgstr ""

